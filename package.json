{
	"name": "witness",
	"type": "module",
	"private": true,
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"apps/witness-pi/extensions"
		]
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"catalog": {
		"@types/bun": "^1.4.2",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"build": "bun build",
		"build:pi": "bun run --cwd apps/witness-pi build",
		"build:web": "bun run --cwd packages/local-web build",
		"test:extensions": "bun test packages/witness apps/witness-pi",
		"test:web": "bun run --cwd packages/local-web test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "catalog:"
	},
	"peerDependencies": {
		"typescript": "catalog:"
	}
}
